# Copy to .env and configure your own Nebius account for explicitly bounded runs.
# Offline examples, saved playback and unit tests do not need a key.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_RESPONSE_FORMAT=json_schema
NEBIUS_ENABLE_THINKING=true
